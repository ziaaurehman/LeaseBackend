generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_DATABASE_URL")
}

// ─── Enums ────────────────────────────────────────────────────────────────────

enum Role {
  SUPER_ADMIN
  ADMIN
  LEASE_AGENT
  FINANCE_AGENT
  PROPERTY_MANAGER
}

enum PropertyType {
  RESIDENTIAL
  COMMERCIAL
  MIXED
}

enum UnitType {
  STUDIO
  ONE_BED
  TWO_BED
  THREE_BED
  PENTHOUSE
  OFFICE
  SHOP
  WAREHOUSE
  OTHER
}

enum UnitStatus {
  AVAILABLE
  OCCUPIED
  MAINTENANCE
  RESERVED
}

enum SizeUnit {
  SQFT
  SQMT
}

enum TenantType {
  INDIVIDUAL
  COMPANY
}

enum DocumentType {
  PASSPORT
  NATIONAL_ID
  EMIRATES_ID
  VISA
  TRADE_LICENSE
  EMPLOYMENT_LETTER
  BANK_STATEMENT
  TENANCY_CONTRACT
  OTHER
}

enum LeaseStatus {
  DRAFT
  ACTIVE
  EXPIRED
  TERMINATED
}

enum PaymentFrequency {
  MONTHLY
  QUARTERLY
  SEMI_ANNUALLY
  ANNUALLY
}

enum RentScheduleStatus {
  PENDING
  PAID
  PARTIAL
  OVERDUE
  WAIVED
}

enum ChequeStatus {
  PENDING
  DEPOSITED
  CLEARED
  BOUNCED
  REPLACED
  CANCELLED
}

enum SecurityDepositStatus {
  HELD
  REFUNDED
  FORFEITED
  PARTIAL
}

// ─── Models ───────────────────────────────────────────────────────────────────

model User {
  id                  String    @id @default(uuid())
  name                String
  email               String    @unique
  password            String
  role                Role
  isActive            Boolean   @default(true)
  mustChangePassword  Boolean   @default(true)
  failedLoginAttempts Int       @default(0)
  lockedUntil         DateTime?
  lastLoginAt         DateTime?
  isDeleted           Boolean   @default(false)
  deletedAt           DateTime?
  deletedBy           String?
  createdAt           DateTime  @default(now())
  updatedAt           DateTime  @updatedAt

  @@map("users")
}

model Property {
  id          String       @id @default(uuid())
  name        String
  type        PropertyType
  address     String
  city        String
  state       String?
  country     String
  postalCode  String?
  description String?
  amenities   String[]
  images      String[]
  isActive    Boolean      @default(true)
  isDeleted   Boolean      @default(false)
  deletedAt   DateTime?
  deletedBy   String?
  createdBy   String
  createdAt   DateTime     @default(now())
  updatedAt   DateTime     @updatedAt

  units Unit[]

  @@map("properties")
}

model Unit {
  id          String     @id @default(uuid())
  propertyId  String
  property    Property   @relation(fields: [propertyId], references: [id])
  unitNumber  String
  floor       Int?
  type        UnitType
  size        Float?
  sizeUnit    SizeUnit   @default(SQFT)
  bedrooms    Int?
  bathrooms   Int?
  rentAmount  Decimal    @db.Decimal(10, 2)
  currency    String     @default("USD")
  status      UnitStatus @default(AVAILABLE)
  description String?
  images      String[]
  features    String[]
  isDeleted   Boolean    @default(false)
  deletedAt   DateTime?
  deletedBy   String?
  createdAt   DateTime   @default(now())
  updatedAt   DateTime   @updatedAt

  leases Lease[]

  @@unique([propertyId, unitNumber])
  @@map("units")
}

model Tenant {
  id                String     @id @default(uuid())
  type              TenantType @default(INDIVIDUAL)
  displayName       String
  firstName         String?
  lastName          String?
  dateOfBirth       DateTime?
  nationality       String?
  nationalIdNumber  String?
  passportNumber    String?
  companyName       String?
  tradeLicenseNo    String?
  contactPerson     String?
  email             String?
  phone             String
  alternatePhone    String?
  address           String?
  city              String?
  country           String?
  emergencyName     String?
  emergencyPhone    String?
  emergencyRelation String?
  notes             String?
  createdBy         String
  isDeleted         Boolean    @default(false)
  deletedAt         DateTime?
  deletedBy         String?
  createdAt         DateTime   @default(now())
  updatedAt         DateTime   @updatedAt

  documents TenantDocument[]
  leases    Lease[]

  @@index([isDeleted])
  @@index([type, isDeleted])
  @@index([email])
  @@index([phone])
  @@index([createdBy])
  @@index([nationalIdNumber])
  @@index([passportNumber])
  @@index([displayName])
  @@index([createdAt])
  @@map("tenants")
}

model TenantDocument {
  id         String       @id @default(uuid())
  tenantId   String
  tenant     Tenant       @relation(fields: [tenantId], references: [id])
  type       DocumentType
  fileUrl    String
  publicId   String
  fileName   String
  fileSize   Int
  mimeType   String
  expiryDate DateTime?
  notes      String?
  uploadedBy String
  isDeleted  Boolean      @default(false)
  deletedAt  DateTime?
  deletedBy  String?
  createdAt  DateTime     @default(now())
  updatedAt  DateTime     @updatedAt

  @@index([tenantId, isDeleted])
  @@index([tenantId, type])
  @@index([expiryDate])
  @@map("tenant_documents")
}

model Lease {
  id               String        @id @default(uuid())
  tenantId         String
  tenant           Tenant        @relation(fields: [tenantId], references: [id])
  unitId           String
  unit             Unit          @relation(fields: [unitId], references: [id])

  startDate        DateTime
  endDate          DateTime

  annualRent       Decimal       @db.Decimal(12, 2)
  currency         String        @default("USD")
  paymentFrequency PaymentFrequency
  securityDeposit  Decimal?      @db.Decimal(12, 2)
  securityDepositPaid    Boolean @default(false)
  securityDepositStatus  SecurityDepositStatus @default(HELD)
  securityDepositRefund  Decimal? @db.Decimal(12, 2)
  securityDepositNote    String?

  isChequePayment  Boolean       @default(false)
  numberOfCheques  Int?

  contractUrl      String?
  contractPublicId String?

  status           LeaseStatus   @default(DRAFT)
  notes            String?
  createdBy        String

  terminatedAt        DateTime?
  terminationReason   String?
  earlyTerminationFee Decimal?   @db.Decimal(12, 2)

  isDeleted  Boolean   @default(false)
  deletedAt  DateTime?
  deletedBy  String?
  createdAt  DateTime  @default(now())
  updatedAt  DateTime  @updatedAt

  rentSchedule RentSchedule[]
  cheques      Cheque[]

  @@index([tenantId, status])
  @@index([unitId, status])
  @@index([status])
  @@index([startDate, endDate])
  @@index([createdBy])
  @@index([isDeleted])
  @@map("leases")
}

model RentSchedule {
  id            String             @id @default(uuid())
  leaseId       String
  lease         Lease              @relation(fields: [leaseId], references: [id])

  installmentNo    Int
  dueDate          DateTime
  amount           Decimal          @db.Decimal(12, 2)
  currency         String
  isProratedFirst  Boolean          @default(false)
  isProratedLast   Boolean          @default(false)

  status     RentScheduleStatus @default(PENDING)
  paidAmount Decimal            @db.Decimal(12, 2) @default(0)
  paidAt     DateTime?
  paidBy     String?
  notes      String?

  cheques  Cheque[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([leaseId, status])
  @@index([leaseId, dueDate])
  @@index([dueDate, status])
  @@map("rent_schedule")
}

model Cheque {
  id        String @id @default(uuid())
  leaseId   String
  lease     Lease  @relation(fields: [leaseId], references: [id])

  scheduleId String?
  schedule   RentSchedule? @relation(fields: [scheduleId], references: [id])

  chequeNumber      String
  bankName          String
  bankBranch        String?
  accountHolderName String?
  accountNumber     String?
  amount            Decimal      @db.Decimal(12, 2)
  currency          String
  dueDate           DateTime

  status      ChequeStatus @default(PENDING)
  depositedAt DateTime?
  clearedAt   DateTime?
  bouncedAt   DateTime?
  bounceReason String?
  bounceFee   Decimal?    @db.Decimal(10, 2)

  replacedById String? @unique
  replacedBy   Cheque? @relation("ChequeReplacement", fields: [replacedById], references: [id])
  replaces     Cheque? @relation("ChequeReplacement")

  notes      String?
  recordedBy String

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([leaseId, status])
  @@index([scheduleId])
  @@index([dueDate])
  @@index([status])
  @@map("cheques")
}
